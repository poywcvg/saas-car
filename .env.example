# نمونه‌ی متغیرهای محیطی — این فایل را به .env کپی کنید و مقادیر را پر کنید
#   cp .env.example .env

# کلید امنیتی جنگو (اجباری در تولید). برای ساخت یک کلید تازه:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# حالت دیباگ: در توسعه True، در تولید حتماً False
DJANGO_DEBUG=True
